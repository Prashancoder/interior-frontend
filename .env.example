# Decore AI Configuration Example
# Copy this file to .env and configure your local environment settings.

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=decore_ai


QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interior_products
USE_MOCK_QDRANT=1


# JWT Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File Upload Configuration
UPLOAD_DIR=uploads

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interior_products

# CLIP / OpenCLIP Model Configuration
# Options for OpenCLIP model names: ViT-B-32, ViT-L-14, RN50
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Groq Vision AI Configuration (Backend Only - Never expose to client!)
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Image Generation Provider Configuration
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_API_KEY=
